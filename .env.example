# =============================================================================
# Sistema Interno FG - environment variables
# =============================================================================
# Copy this file to `.env` for local development, or set each variable in your
# hosting provider's dashboard for staging/production. See:
#   - docs/runbooks/staging-setup.md   (provisioning steps)
#   - docs/runbooks/backup-restore.md  (database backup procedure)
#   - docs/launch-checklist-v1.md      (PRD §22 product decisions)
# =============================================================================


# -----------------------------------------------------------------------------
# Database (Postgres 17)
# -----------------------------------------------------------------------------
# DATABASE_URL: pooled connection string used by the app at runtime.
#   - Local:   postgres://postgres:postgres@localhost:5432/erp_agencia
#   - Neon:    postgres://...@<pooler-host>/<db>?sslmode=require
#   - RDS/DO:  postgres://...@<host>:5432/<db>?sslmode=require
DATABASE_URL=

# DATABASE_DIRECT_URL: direct (non-pooled) connection used by drizzle-kit for
# migrations. Required because the pooler does not support prepared statements.
# On Neon, this is the "direct" connection string; on self-hosted Postgres,
# usually identical to DATABASE_URL.
DATABASE_DIRECT_URL=


# -----------------------------------------------------------------------------
# Authentication (Better Auth)
# -----------------------------------------------------------------------------
# BETTER_AUTH_SECRET: 32+ byte random secret. Generate with:
#   openssl rand -hex 32
# Rotate per environment. NEVER reuse the prod secret in staging.
BETTER_AUTH_SECRET=

# BETTER_AUTH_URL: the public base URL where the app is served.
#   - Local:    http://localhost:3000
#   - Staging:  https://staging.formulagroup.com.br
#   - Prod:     https://app.formulagroup.com.br   # PRD §22 decision #2
BETTER_AUTH_URL=http://localhost:3000

# BETTER_AUTH_TRUSTED_ORIGINS: comma-separated origins allowed to call the auth
# API. Must include BETTER_AUTH_URL exactly. Add any custom domain or preview
# host you want to allow sign-in from.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# NEXT_PUBLIC_BETTER_AUTH_URL: same as BETTER_AUTH_URL but exposed to the
# browser. Must match BETTER_AUTH_URL.
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# ENABLE_EMAIL_PASSWORD_AUTH: turn the email/password sign-in form on/off.
# Recommended for prod: `false` if Google SSO covers everyone, `true` if
# external collaborators (e.g. occasional freelancers) need a password.
ENABLE_EMAIL_PASSWORD_AUTH=true

# ENABLE_EMAIL_PASSWORD_SIGN_UP: allow public self-signup. Recommended for
# prod: `false` (invitations only).
ENABLE_EMAIL_PASSWORD_SIGN_UP=true

# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET: OAuth client from Google Cloud.
# Create one per environment. Authorized redirect URI must be:
#   <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ALLOWED_EMAIL_DOMAIN: restrict sign-in to a single email domain. Empty
# string disables the check (any verified Google account works).
# Production: set to the company domain. PRD §22 decision #4.
#   Example: ALLOWED_EMAIL_DOMAIN=formulagroup.com.br
ALLOWED_EMAIL_DOMAIN=

# APP_URL: canonical app URL used for absolute links in emails / audit
# metadata. Usually identical to BETTER_AUTH_URL.
APP_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# Object storage (uploads)
# -----------------------------------------------------------------------------
# STORAGE_PROVIDER: where uploaded files live.
#   - "local"  -> filesystem under LOCAL_UPLOAD_DIR (dev only)
#   - "r2"     -> Cloudflare R2 (supported, recommended for prod)
#   - "s3"     -> any S3-compatible store (AWS S3, Backblaze B2, MinIO, etc.)
# Leave empty in dev to auto-fallback to "local".
# PRD §22 decision #3.
STORAGE_PROVIDER=

# STORAGE_BUCKET: bucket name. Must already exist with the API key below
# granted read/write on it. Disable public access on the bucket.
STORAGE_BUCKET=

# STORAGE_REGION: region the bucket lives in. For R2 this is "auto".
STORAGE_REGION=

# STORAGE_ENDPOINT: S3-compatible endpoint URL. For R2:
#   https://<STORAGE_ACCOUNT_ID>.r2.cloudflarestorage.com
# For AWS S3, leave empty (the SDK derives it from STORAGE_REGION).
STORAGE_ENDPOINT=

# STORAGE_ACCOUNT_ID: R2 account ID (Cloudflare). Not used by AWS S3.
STORAGE_ACCOUNT_ID=

# STORAGE_ACCESS_KEY_ID / STORAGE_SECRET_ACCESS_KEY: API credentials scoped to
# STORAGE_BUCKET only. Generate one set per environment. Rotate quarterly.
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# LOCAL_UPLOAD_DIR: where to write files when STORAGE_PROVIDER=local.
# Ignored in production.
LOCAL_UPLOAD_DIR=uploads


# -----------------------------------------------------------------------------
# Bootstrap admin (PRD §22 decision #5)
# -----------------------------------------------------------------------------
# The seed (`npm run db:seed`) creates this user with technical_admin + director
# roles on first run. After bootstrap, rotate the password through the UI and
# manage further users via /app/configuracoes.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_NAME=

# INITIAL_ADMIN_PASSWORD: temporary password for the initial admin. Required
# even if you'll sign in via Google immediately - it bootstraps the account
# before Google linking. Use `openssl rand -base64 24` and rotate after first
# login.
INITIAL_ADMIN_PASSWORD=


# -----------------------------------------------------------------------------
# Demo / seed data
# -----------------------------------------------------------------------------
# SEED_DEMO_DATA: when "true", the seed also creates 8 demo users, 3 employees,
# and a vacation balance. Use ONLY in local dev or a throwaway sandbox.
# Production: false. Staging: false unless you specifically want demo data.
SEED_DEMO_DATA=false

# DEMO_USER_PASSWORD: required when SEED_DEMO_DATA=true. There is no fallback.
DEMO_USER_PASSWORD=


# -----------------------------------------------------------------------------
# Upload limits
# -----------------------------------------------------------------------------
# UPLOAD_MAX_BYTES: hard cap per uploaded file. Default 10 MB.
# PRD §22 decision #6. Adjust if NF PDFs or contracts regularly exceed 10 MB.
#   10 MB  = 10485760
#   25 MB  = 26214400
#   50 MB  = 52428800
UPLOAD_MAX_BYTES=10485760
