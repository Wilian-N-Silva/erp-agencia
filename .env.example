# Sistema Interno FG — ambiente LOCAL (PostgreSQL 17 + Next.js)
# Copie para .env sem sobrescrever configurações existentes.
# Guia: docs/runbooks/environment-setup.md. Substitua <...> antes de executar.
# Nunca versionar o arquivo preenchido. Produção: .env.production.example.

# BANCO obrigatório. Docker não cria automaticamente as duas roles abaixo.
# Siga database-roles.md: runtime sem SUPERUSER/BYPASSRLS/propriedade de tabelas.
# Senhas em URLs precisam de percent-encoding para caracteres como @, /, # e %.
DATABASE_URL=postgresql://erp_app:<senha-runtime>@127.0.0.1:55432/erp_agencia
# Migration/seed: role separada com BYPASSRLS e DDL; nunca no runtime público.
DATABASE_DIRECT_URL=postgresql://erp_migrator:<senha-migrator>@127.0.0.1:55432/erp_agencia
# Testes: copie .env.test.example para .env.test.local e use erp_agencia_test.
# Nunca use erp_agencia em DATABASE_TEST_URL: a suíte altera dados/schema.

# SEGREDOS obrigatórios e independentes; gere CADA valor com:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Better Auth protege sessões; rotação pode invalidá-las.
BETTER_AUTH_SECRET=
# HMAC anonimiza identificadores nos limites persistidos de requisições.
RATE_LIMIT_HASH_SECRET=

# URLs: mantenha coerência com o endereço usado no navegador.
# localhost e 127.0.0.1 são origens distintas; não misture durante o login.
BETTER_AUTH_URL=http://localhost:3000
# Origens adicionais separadas por vírgula, sem caminhos ou curingas.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
# Público no navegador; alteração exige rebuild em produção.
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
# URL canônica para links absolutos do sistema.
APP_URL=http://localhost:3000

# LOGIN por senha, inclusive para build/start local.
ENABLE_EMAIL_PASSWORD_AUTH=true
# Cadastro público; false mantém acesso administrado por convites.
ENABLE_EMAIL_PASSWORD_SIGN_UP=false
# Google opcional com senha habilitada. Preencha AMBOS ou deixe vazios.
# Google Cloud > cliente OAuth Web; callback:
# <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Domínio sem @. Vazio remove filtro de domínio, não concede roles/organização.
ALLOWED_EMAIL_DOMAIN=

# ARQUIVOS: código atual seleciona R2 quando bucket + endpoint/account + chaves
# estão completos; caso contrário usa filesystem. STORAGE_PROVIDER não força
# o backend em storage.ts; também é metadado do seed. S3 genérico não validado.
# Para local, mantenha as credenciais R2 vazias.
STORAGE_PROVIDER=local
# Relativo à raiz; persistente e ignorado pelo Git. Não é ignorado em produção.
LOCAL_UPLOAD_DIR=uploads
# R2 opcional no local: nome de bucket privado criado no Cloudflare.
STORAGE_BUCKET=
STORAGE_REGION=auto
# Endpoint tem precedência sobre Account ID:
# https://<account-id>.r2.cloudflarestorage.com
STORAGE_ENDPOINT=
# Alternativa ao endpoint; Account ID Cloudflare, não nome do bucket.
STORAGE_ACCOUNT_ID=
# Credenciais S3 do token R2 com leitura/escrita somente no bucket necessário.
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Limite por arquivo em bytes: 10485760 = 10 MiB.
UPLOAD_MAX_BYTES=10485760

# PRIMEIRO ADMIN: somente npm run db:seed. Email/senha necessários para criá-lo.
# Nome vazio usa Admin Local; sem email/senha o seed pula a criação do admin.
# Escolha email compatível com ALLOWED_EMAIL_DOMAIN e senha forte temporária.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_PASSWORD=
# Seed não é restart: repetir pode atualizar contas e redefinir senhas.
# true cria contas/clientes e outros exemplos fictícios. Só base descartável.
SEED_DEMO_DATA=false
# Obrigatória quando SEED_DEMO_DATA=true; não há senha padrão.
DEMO_USER_PASSWORD=

# LIMITES opcionais: padrões atuais em src/lib/rate-limit/config.ts.
# LIMIT = quantidade; WINDOW_SECONDS = janela em segundos.
# Autenticação possui proteção própria adicional.
RATE_LIMIT_INVITATION_LIMIT=10
RATE_LIMIT_INVITATION_WINDOW_SECONDS=600
RATE_LIMIT_UPLOAD_LIMIT=20
RATE_LIMIT_UPLOAD_WINDOW_SECONDS=600
RATE_LIMIT_EXPORT_LIMIT=5
RATE_LIMIT_EXPORT_WINDOW_SECONDS=300
RATE_LIMIT_RECONCILIATION_LIMIT=30
RATE_LIMIT_RECONCILIATION_WINDOW_SECONDS=300
RATE_LIMIT_COMMON_MUTATION_LIMIT=120
RATE_LIMIT_COMMON_MUTATION_WINDOW_SECONDS=60
RATE_LIMIT_GRAPHICS_IMPORT_LIMIT=3
RATE_LIMIT_GRAPHICS_IMPORT_WINDOW_SECONDS=3600
RATE_LIMIT_FINANCIAL_TRANSACTION_LIMIT=30
RATE_LIMIT_FINANCIAL_TRANSACTION_WINDOW_SECONDS=300
# Probabilidade (0 a 1) de limpeza por consumo; máximo de registros por lote.
RATE_LIMIT_CLEANUP_PROBABILITY=0.01
RATE_LIMIT_CLEANUP_BATCH_SIZE=500
