# =============================================================================
# Sistema Interno FG - local integration-test environment
# =============================================================================
# Copy to `.env.test.local` and replace every placeholder before running
# `npm run test:db`. Never target development, staging, or production data.
# Explicit shell/CI variables take precedence over this file.
# =============================================================================


# Runtime role: NOSUPERUSER, NOBYPASSRLS, and not the table owner.
DATABASE_TEST_URL=postgresql://codex_test_app:<app-password>@127.0.0.1:55432/erp_agencia_test
DATABASE_URL=postgresql://codex_test_app:<app-password>@127.0.0.1:55432/erp_agencia_test

# Migration role: controlled BYPASSRLS role for the same isolated database.
DATABASE_TEST_ADMIN_URL=postgresql://codex_test_migrator:<migrator-password>@127.0.0.1:55432/erp_agencia_test
DATABASE_DIRECT_URL=postgresql://codex_test_migrator:<migrator-password>@127.0.0.1:55432/erp_agencia_test

# Test-only secrets. Do not reuse values from any deployed environment.
BETTER_AUTH_SECRET=local-test-only-better-auth-secret-change-me
RATE_LIMIT_HASH_SECRET=local-test-only-rate-limit-secret-change-me

# Local endpoints used by integration/E2E tests.
BETTER_AUTH_URL=http://127.0.0.1:3100
BETTER_AUTH_TRUSTED_ORIGINS=http://127.0.0.1:3100
NEXT_PUBLIC_BETTER_AUTH_URL=http://127.0.0.1:3100
APP_URL=http://127.0.0.1:3100

ENABLE_EMAIL_PASSWORD_AUTH=true
ENABLE_EMAIL_PASSWORD_SIGN_UP=false
ALLOWED_EMAIL_DOMAIN=

STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIR=storage-local/test-uploads
SEED_DEMO_DATA=false
UPLOAD_MAX_BYTES=10485760
