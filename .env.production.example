# =============================================================================
# Sistema Interno FG - production environment template
# =============================================================================
# Target deployment: https://app.formulagroup.com.br (Vercel).
#
# Do NOT commit a real `.env.production` to the repo (.gitignore enforces it).
# Set each variable in the Vercel dashboard ("Production" scope) instead.
#
# Companion docs:
#   - docs/runbooks/production-setup.md   (full provisioning + DNS + OAuth)
#   - docs/runbooks/backup-restore.md     (database backup drill)
#   - docs/launch-checklist-v1.md         (PRD §22 product decisions)
# =============================================================================


# -----------------------------------------------------------------------------
# Database (Postgres 17 on Neon)
# -----------------------------------------------------------------------------
# Pooled connection used by the running app. Format:
#   postgres://<user>:<pwd>@<pooler-host>/<db>?sslmode=require
DATABASE_URL=

# Direct (non-pooled) connection used by drizzle-kit migrations.
# Required because the pooler does not support prepared statements.
DATABASE_DIRECT_URL=


# -----------------------------------------------------------------------------
# Authentication (Better Auth)
# -----------------------------------------------------------------------------
# 32+ byte random secret, unique per environment. Generate with:
#   openssl rand -hex 32
# NEVER reuse the staging secret.
BETTER_AUTH_SECRET=

# Public base URL for the auth API. Must be HTTPS in production.
BETTER_AUTH_URL=https://app.formulagroup.com.br

# Trusted origins allowed to call the auth API. Comma-separated.
# Keep it minimal — only the production host.
BETTER_AUTH_TRUSTED_ORIGINS=https://app.formulagroup.com.br

# Same as BETTER_AUTH_URL but exposed to the browser. Must match exactly.
NEXT_PUBLIC_BETTER_AUTH_URL=https://app.formulagroup.com.br

# Canonical app URL used for absolute links (emails, audit metadata).
APP_URL=https://app.formulagroup.com.br

# Email/password sign-in. Default for prod: off if Google SSO covers everyone,
# on only if external collaborators (e.g. occasional freelancers) need it.
ENABLE_EMAIL_PASSWORD_AUTH=false

# Public self sign-up. Always false in prod (invitations only).
ENABLE_EMAIL_PASSWORD_SIGN_UP=false

# Google OAuth client dedicated to production. Authorized redirect URI:
#   https://app.formulagroup.com.br/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Restrict sign-in to a single email domain.
ALLOWED_EMAIL_DOMAIN=formulagroup.com.br


# -----------------------------------------------------------------------------
# Object storage (Cloudflare R2)
# -----------------------------------------------------------------------------
STORAGE_PROVIDER=r2
STORAGE_BUCKET=erp-prod-uploads
STORAGE_REGION=auto
STORAGE_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
STORAGE_ACCOUNT_ID=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=


# -----------------------------------------------------------------------------
# Bootstrap admin (PRD §22 decision #5)
# -----------------------------------------------------------------------------
# Seeded once on the first migration of an empty prod DB. Rotate the password
# through the UI immediately after first login.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_PASSWORD=


# -----------------------------------------------------------------------------
# Demo / seed data — MUST be false in prod
# -----------------------------------------------------------------------------
SEED_DEMO_DATA=false
DEMO_USER_PASSWORD=


# -----------------------------------------------------------------------------
# Upload limits
# -----------------------------------------------------------------------------
UPLOAD_MAX_BYTES=10485760
