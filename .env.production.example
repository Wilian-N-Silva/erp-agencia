# Sistema Interno FG — SOMENTE runtime público, independente da hospedagem.
# Vercel suspensa por decisão do responsável em 22/09/2026 após remoção do banco.
# Não presume infraestrutura ativa. Recrie banco/roles e migre antes de publicar.
# Guia e bootstrap separado: docs/runbooks/environment-setup.md.
# Configure no gerenciador de segredos da hospedagem. Não versionar valores reais.
# NÃO incluir DATABASE_DIRECT_URL, INITIAL_ADMIN_* ou DEMO_USER_PASSWORD aqui.

# PostgreSQL 17: role runtime restrita, não proprietária das tabelas.
# Obtenha host/base no provedor e crie roles conforme database-roles.md.
# Use TLS conforme provedor (ex.: ?sslmode=require) e percent-encode a senha.
DATABASE_URL=
# Gere dois segredos de 32 bytes independentes e exclusivos deste ambiente:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
RATE_LIMIT_HASH_SECRET=

# Substitua pelo domínio HTTPS provisionado; estes valores são exemplos.
BETTER_AUTH_URL=https://app.formulagroup.com.br
BETTER_AUTH_TRUSTED_ORIGINS=https://app.formulagroup.com.br
# Público e incorporado ao bundle; alterar exige rebuild.
NEXT_PUBLIC_BETTER_AUTH_URL=https://app.formulagroup.com.br
APP_URL=https://app.formulagroup.com.br

# SSO por padrão: configure Google OU habilite senha deliberadamente.
# Não deixe ambos os métodos de login desabilitados.
ENABLE_EMAIL_PASSWORD_AUTH=false
ENABLE_EMAIL_PASSWORD_SIGN_UP=false
# Cliente OAuth Web exclusivo; callback <BETTER_AUTH_URL>/api/auth/callback/google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Domínio sem @. Não substitui convites, roles ou organização.
ALLOWED_EMAIL_DOMAIN=formulagroup.com.br

# R2: bucket privado + endpoint/account + ambas as chaves são necessários.
# STORAGE_PROVIDER=r2 sozinho NÃO força R2: configuração incompleta faz o código
# atual usar filesystem local, inadequado em hospedagem com disco efêmero.
STORAGE_PROVIDER=r2
STORAGE_BUCKET=
STORAGE_REGION=auto
# Preencha endpoint OU Account ID. Endpoint explícito tem precedência.
STORAGE_ENDPOINT=
STORAGE_ACCOUNT_ID=
# Credenciais S3 do token R2, escopadas ao bucket.
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Limite por arquivo em bytes (10 MiB).
UPLOAD_MAX_BYTES=10485760
SEED_DEMO_DATA=false

# Overrides opcionais: LIMIT = operações; WINDOW_SECONDS = janela em segundos.
RATE_LIMIT_INVITATION_LIMIT=10
RATE_LIMIT_INVITATION_WINDOW_SECONDS=600
RATE_LIMIT_UPLOAD_LIMIT=20
RATE_LIMIT_UPLOAD_WINDOW_SECONDS=600
RATE_LIMIT_EXPORT_LIMIT=5
RATE_LIMIT_EXPORT_WINDOW_SECONDS=300
RATE_LIMIT_RECONCILIATION_LIMIT=30
RATE_LIMIT_RECONCILIATION_WINDOW_SECONDS=300
RATE_LIMIT_COMMON_MUTATION_LIMIT=120
RATE_LIMIT_COMMON_MUTATION_WINDOW_SECONDS=60
RATE_LIMIT_GRAPHICS_IMPORT_LIMIT=3
RATE_LIMIT_GRAPHICS_IMPORT_WINDOW_SECONDS=3600
RATE_LIMIT_FINANCIAL_TRANSACTION_LIMIT=30
RATE_LIMIT_FINANCIAL_TRANSACTION_WINDOW_SECONDS=300
# Probabilidade de limpeza (0 a 1) e máximo de registros por lote.
RATE_LIMIT_CLEANUP_PROBABILITY=0.01
RATE_LIMIT_CLEANUP_BATCH_SIZE=500
